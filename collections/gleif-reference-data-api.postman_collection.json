  "info": {
    "_postman_id": "5eef3ebe-47fa-4b5f-b4d6-9da2d06ea450",
    "name": "GLEIF LEI Corporate Relationships Reference Data API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The GLEIF LEI API provides programmatic access to the Global Legal Entity Identifier (LEI) System's full data pool. It enables searches by entity name, LEI code, BIC code, ISIN code, and corporate relationship structures. The API is free, open, and requires no authentication or API key. It is built on the GLEIF Golden Copy dataset which is updated three times daily.\n\n\nContact Support:\n Name: GLEIF",
      "type": "text/plain"
    }
  }
